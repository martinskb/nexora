# Copie para .env e preencha. O arquivo .env NÃO deve ir para o git.
NODE_ENV=development
PORT=3333

# Endereço do frontend (liberado no CORS)
CORS_ORIGIN=http://localhost:5173

# Banco de dados (MySQL/MariaDB)
DB_HOST=localhost
DB_PORT=3306
DB_USER=nexora
DB_PASSWORD=
DB_NAME=nexora
# Banco separado usado pelos testes automáticos (é limpo a cada execução)
DB_NAME_TEST=nexora_test
# Banco na nuvem: conexão com SSL. Cole o ca.pem do provedor em DB_SSL_CA
# (pode usar \n no lugar das quebras de linha) ou use DB_SSL=true.
# DB_SSL_CA=
# DB_SSL=true

# Proxies na frente da API em produção (Vercel → Render = 2). Deixe vazio localmente.
# TRUST_PROXY=

# Segredo para assinar os tokens de login (gere um valor longo e aleatório)
JWT_SECRET=
# Duração da sessão de login, em dias
SESSAO_DIAS=7
